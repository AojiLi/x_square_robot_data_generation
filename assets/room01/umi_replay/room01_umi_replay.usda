#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @../sim/room01_manipulation.usda@
    ]
)

over "World"
{
    over "Task"
    {
        over "RedCube" (
            active = false
        )
        {
        }

        def Xform "RedBig" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00003, 0.00003, 0.00003)
            float physics:mass = 0.072
            bool physxRigidBody:enableCCD = 1
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 8
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.773105726402287, -1.8540779958582403, 0.7482)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "Shape0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/UmiRedBig>
                rel material:binding:physics = </World/PhysicsMaterials/UmiWood> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.0005
                float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.05, 0.05, 0.05)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

