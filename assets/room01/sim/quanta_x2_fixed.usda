    def "TrainingMaterials"
    {
        def Material "FingerContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            token physxMaterial:frictionCombineMode = "average"
            token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def "TrainingLooks"
    {
        def Material "Revo2"
        {
            token outputs:surface.connect = </Robot/TrainingLooks/Revo2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.017, 0.02, 0.024)
                float inputs:ior = 1.5
                float inputs:metallic = 0.12
                float inputs:opacity = 1
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "WhiteShell"
        {
            token outputs:surface.connect = </Robot/TrainingLooks/WhiteShell/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.745, 0.73)
                float inputs:ior = 1.5
                float inputs:metallic = 0.08
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Adapter"
        {
            token outputs:surface.connect = </Robot/TrainingLooks/Adapter/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.065, 0.11)
                float inputs:ior = 1.5
                float inputs:metallic = 0.45
                float inputs:opacity = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Tire"
        {
            token outputs:surface.connect = </Robot/TrainingLooks/Tire/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.013, 0.016)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

