                        matrix4d xformOp:transform = ( (-0.0000010181202712011839, -0.000004353549636619547, -0.9999999999900052, 0), (0.0756302476232115, -0.9971359313685721, 0.00000426408008350615, 0), (-0.9971359313771696, -0.07563024761811421, 0.00000134446434152391, 0), (0.02, 0.01, 0.025, 1) )
                        uniform token[] xformOpOrder = ["xformOp:transform"]
                    }
                }
            }
        }
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        token physxScene:broadphaseType = "GPU"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 1
        token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 960
    }

    def "PhysicsMaterials"
    {
        def Material "TrainingProp" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.75
            token physxMaterial:frictionCombineMode = "average"
            token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def "Task"
    {
        def Xform "RedCube" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            float3 physics:diagonalInertia = (0.000016, 0.000016, 0.000016)
            float physics:mass = 0.06
            bool physxRigidBody:enableCCD = 1
            int physxRigidBody:solverPositionIterationCount = 16
            int physxRigidBody:solverVelocityIterationCount = 4
            double3 xformOp:translate = (0.95, -2.16, 0.747)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Shape" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/RedCube>
                rel material:binding:physics = </World/PhysicsMaterials/TrainingProp> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                bool physics:collisionEnabled = 1
                float physxCollision:contactOffset = 0.001
                float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.04, 0.04, 0.04)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def "Looks"
    {
        def Material "RedCube"
        {
            token outputs:surface.connect = </World/Looks/RedCube/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.025, 0.018)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def "Lighting"
    {
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.82, 0.9, 1)
            float inputs:intensity = 1200
        }

        def DistantLight "Daylight"
        {
            float inputs:angle = 7
            float inputs:intensity = 3000
            float3 xformOp:rotateXYZ = (-55, 0, 20)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def RectLight "CeilingFill"
        {
            float inputs:height = 3.2
            float inputs:intensity = 1500
            float inputs:width = 3.6
            double3 xformOp:translate = (0, -0.4, 2.56)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def RectLight "DeskFill"
        {
            float inputs:height = 1.2
            float inputs:intensity = 650
            float inputs:width = 1.2
            double3 xformOp:translate = (0.2, -1.9, 2.3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Camera "ReviewSetup"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 24
        matrix4d xformOp:transform = ( (-0.9212495614113859, 0.3889720370403629, 0, 0), (-0.17344010917192085, -0.41077920593349687, 0.8950860140249529, 0), (0.3481634302016246, 0.8245975978459532, 0.44589351587225623, -0), (1.2499999999999998, -0.5999999999999999, 1.5499999999999996, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Camera "ReviewTable"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 24
        matrix4d xformOp:transform = ( (0.05989229072794677, -0.9982048454657787, -3.469446951953614e-18, 0), (0.5606109822347566, 0.03363665893408542, 0.8273958555452967, 0), (-0.8259105521236186, -0.04955463312741716, 0.5616191754440606, 0), (-1.3877787807814457e-17, -2, 1.4, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

