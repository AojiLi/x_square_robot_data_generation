                        custom float omni:lensdistortion:opencvFisheye:k3 = 0
                        custom float omni:lensdistortion:opencvFisheye:k4 = 0
                        token projection = "perspective"
                        float verticalAperture = 58.888824
                        float verticalApertureOffset = 0.58966446
                        matrix4d xformOp:transform = ( (0.0000010181106536721884, -0.000004353508280777185, 0.9999999999900051, 0), (0.07563024762311366, 0.9971359313685795, 0.000004264039573473322, 0), (-0.9971359313771768, 0.07563024761801648, 0.0000013444516241412074, 0), (0.02, -0.01, 0.025, 1) )
                        uniform token[] xformOpOrder = ["xformOp:transform"]
                    }
                }
            }
        }

        over "right_wrist_pitch_link"
        {
            over "FixedFrames"
            {
                over "right_in_hand_camera_link"
                {
                    def Camera "RGB_right_wrist" (
                        delete apiSchemas = ["OmniLensDistortionOpenCvPinholeAPI", "OmniLensDistortionOpenCvFisheyeAPI"]
                        prepend apiSchemas = ["OmniLensDistortionOpenCvFisheyeAPI"]
                        customData = {
                            string calibrationProvenanceJson = '{"active_reference_profile": "user_selected_20260824_request_000001", "distortion_status": "equidistant_zero_KB4_assumption", "estimated_optical_roll_adjustment_deg": 90.0, "extrinsics_status": "provisional_photo_guided", "historical_topic_mapping_note": "Full archive reviewed: 21 old mapping requests are excluded from this fit; 720 requests across 47 sessions match current physical left=camera3, right=camera1. Early image orientation differs; original files and names remain unchanged.", "image_rotation_degrees": 0, "intrinsics_definition": "fx=ellipse_radius_x/(pi/2), fy=ellipse_radius_y/(pi/2), principal point=image-circle center. Boundary is estimated in pixels; 180-degree angular FOV is an assumption.", "intrinsics_status": "estimated_from_image_boundary_with_assumed_180deg_fov", "lens_boundary_fit": {"arc_candidates": 563, "arc_inliers": 415, "ellipse_center_xy_px": [321.6453722695721, 228.67474195985073], "ellipse_radius_xy_px": [249.15016386534305, 249.33083286142156], "equidistant_assumed_full_fov_deg": 180.0, "estimated_fx_fy_if_180deg": [158.61392060530028, 158.72893806045766], "median_boundary_residual_px": 1.3451654891125842, "resolution_wh": [640, 480], "source_frames": 3, "status": "image_boundary_fit_only; field of view and distortion require calibration"}, "lens_boundary_reference": "reports/room01_wrist_fisheye_alignment/lens_boundary_fit.json", "nominal_resize_xy": null, "orientation_reference_priority": "User-specified reference is authoritative over aggregate archive statistics.", "physical_mapping_evidence": "x2-lower:/home/xr/pi05_umi_inference/runtime/robot_observation.py", "pitch_reference": "Image-guided downward optical pitch estimate, using the user-selected reference hand layout; not a measured hand-eye transform.", "reference_authority": "Explicit user correction: this reference angle is correct.", "reference_request_count": 3, "reference_reset_pose": "assets/room01/sim/calibration/wrist_reference_pose_estimate.json", "reference_session_count": 1, "resolution_status": "verified_current_robot_stream", "roll_reference": "User-selected 20260824 request_000001; later archive direction statistics must not override this view convention.", "rotation_evidence": "Orientation is authored in the 3D camera mount, without rotating saved RGB after capture.", "source_topic": "/camera1/usb_cam1/image_raw/image_compressed", "unapplied_reason": "No evidence tying the ctrl calibration to the two independent wrist UVC sensors.", "unapplied_user_group": "ctrl", "view_orientation_reference": "reports/room01_wrist_fisheye_alignment/reference/request_000001/cam_right_wrist.png", "virtual_optical_pitch_delta_deg": -17.5, "virtual_optical_roll_delta_deg": 180.0}'
