#usda 1.0
(
    customLayerData = {
        string cameraCalibration = "Head user-supplied K with provisional KB4 interpretation; wrist roll and pitch follow the user-authoritative 20260824 request_000001 images. Circular fisheye K and real hand-eye remain image-based estimates."
        dictionary cameraSettings = {
            string boundCamera = "/World/ReviewSetup"
        }
        string physicsParameters = "Initial simulation values; physical and camera verification reports are stored alongside the task code."
        dictionary renderSettings = {
            bool "rtx-transient:dlssg:enabled" = 0
            int "rtx:post:aa:op" = 4
            bool "rtx:post:dof:enabled" = 0
            bool "rtx:post:motionblur:enabled" = 0
            string "rtx:rendermode" = "RealTimePathTracing"
        }
        string task = "fixed_base_white_table_manipulation"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    timeCodesPerSecond = 30
    upAxis = "Z"
)

def Xform "World"
{
    def "Room" (
        prepend references = @room_environment.usdc@
    )
    {
    }

    def "Robot" (
        prepend references = @quanta_x2_physics.usdc@
