                        uniform token[] xformOpOrder = ["xformOp:transform"]
                    }
                }
            }
        }

        over "left_wrist_pitch_link"
        {
            over "FixedFrames"
            {
                over "left_in_hand_camera_link"
                {
                    def Camera "RGB_left_wrist" (
                        delete apiSchemas = ["OmniLensDistortionOpenCvPinholeAPI", "OmniLensDistortionOpenCvFisheyeAPI"]
                        prepend apiSchemas = ["OmniLensDistortionOpenCvFisheyeAPI"]
                        customData = {
                            string calibrationProvenanceJson = '{"active_reference_profile": "user_selected_20260824_request_000001", "distortion_status": "equidistant_zero_KB4_assumption", "estimated_optical_roll_adjustment_deg": -90.0, "extrinsics_status": "provisional_photo_guided", "historical_topic_mapping_note": "Full archive reviewed: 21 old mapping requests are excluded from this fit; 720 requests across 47 sessions match current physical left=camera3, right=camera1. Early image orientation differs; original files and names remain unchanged.", "image_rotation_degrees": 0, "intrinsics_definition": "fx=ellipse_radius_x/(pi/2), fy=ellipse_radius_y/(pi/2), principal point=image-circle center. Boundary is estimated in pixels; 180-degree angular FOV is an assumption.", "intrinsics_status": "estimated_from_image_boundary_with_assumed_180deg_fov", "lens_boundary_fit": {"arc_candidates": 468, "arc_inliers": 327, "ellipse_center_xy_px": [326.9935894834079, 244.8063268883286], "ellipse_radius_xy_px": [256.7459211129113, 256.069719155675], "equidistant_assumed_full_fov_deg": 180.0, "estimated_fx_fy_if_180deg": [163.44952985520658, 163.0190463191163], "median_boundary_residual_px": 2.705866375128992, "resolution_wh": [640, 480], "source_frames": 3, "status": "image_boundary_fit_only; field of view and distortion require calibration"}, "lens_boundary_reference": "reports/room01_wrist_fisheye_alignment/lens_boundary_fit.json", "nominal_resize_xy": null, "orientation_reference_priority": "User-specified reference is authoritative over aggregate archive statistics.", "physical_mapping_evidence": "x2-lower:/home/xr/pi05_umi_inference/runtime/robot_observation.py", "pitch_reference": "Image-guided downward optical pitch estimate, using the user-selected reference hand layout; not a measured hand-eye transform.", "reference_authority": "Explicit user correction: this reference angle is correct.", "reference_request_count": 3, "reference_reset_pose": "assets/room01/sim/calibrati