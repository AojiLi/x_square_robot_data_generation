                        float fStop = 0
                        float horizontalAperture = 78.31164
                        float horizontalApertureOffset = -0.85574913
                        custom token omni:lensdistortion:model = "opencvFisheye"
                        custom float omni:lensdistortion:opencvFisheye:cx = 326.9936
                        custom float omni:lensdistortion:opencvFisheye:cy = 244.80632
                        custom float omni:lensdistortion:opencvFisheye:fx = 163.44952
                        custom float omni:lensdistortion:opencvFisheye:fy = 163.01904
                        custom int2 omni:lensdistortion:opencvFisheye:imageSize = (640, 480)
                        custom float omni:lensdistortion:opencvFisheye:k1 = 0
