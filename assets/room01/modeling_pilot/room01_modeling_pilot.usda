#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/ReviewTable"
        }
        string pilotNote = "Blender geometry study with trimmed original scan mesh context. Plain window infill; exterior and remaining furniture not remodeled. Approximate materials; no physics."
        string previewProfile = "Isaac RTX Real-Time 2.0 / native DLAA / measured upright camera presets"
        dictionary renderSettings = {
            bool "rtx-transient:dlssg:enabled" = 0
            int "rtx:post:aa:op" = 4
            int "rtx:post:dlss:execMode" = 2
            bool "rtx:post:dof:enabled" = 0
            bool "rtx:post:motionblur:enabled" = 0
            string "rtx:rendermode" = "RealTimePathTracing"
            bool "rtx:rtpt:gaussian:skipTonemapping:enabled" = 1
        }
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    upAxis = "Z"
)

def Xform "World"
{
    def "ModeledParts" (
        prepend references = @modeled_parts.usdc@
    )
    {
    }

    def DomeLight "PilotAmbient"
    {
        color3f inputs:color = (0.93, 0.96, 1)
        float inputs:intensity = 0.7
    }

    def DistantLight "PilotDaylight"
    {
        float inputs:angle = 18
        float inputs:intensity = 1.2
        float3 xformOp:rotateXYZ = (-30, 20, 25)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def RectLight "DeskSoftbox"
    {
        float inputs:height = 1.2
        float inputs:intensity = 12
        float inputs:width = 1.2
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0.85, -1.95, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def RectLight "RoomSoftbox"
    {
        float inputs:height = 2
        float inputs:intensity = 5
        float inputs:width = 2
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def RectLight "WindowFill"
    {
        float inputs:height = 3
        float inputs:intensity = 3
        float inputs:width = 3
        float3 xformOp:rotateXYZ = (90, 0, 0)
        double3 xformOp:translate = (0.8, 0.25, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

