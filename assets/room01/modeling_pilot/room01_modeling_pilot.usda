def "Render"
{
    def RenderSettings "Settings"
    {
        uniform token aspectRatioConformPolicy = "cropAperture"
        rel camera = </World/ReviewTable>
        uniform float pixelAspectRatio = 1
        uniform int2 resolution = (736, 552)
    }
}

