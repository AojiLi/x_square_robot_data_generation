# Local environments, build products, caches and editor state.
/.venv*/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.DS_Store
.idea/
.vscode/

# Credentials and local process state must never enter the repository.
.env
.env.*
!.env.example
.ssh/
hf-token
*.pem
*.key
*.secret
*.log
*.pid
*.lock
*.tmp
*.bak
*.bak.*

# Original scan archives and bulk input data stay in the local workspace.
/*.zip
/Weixin*.jpg
/data/
/hf-cache/
*.safetensors
*.pt
*.pth

# Retain the current scene, not duplicate backup assets.
*.blend[0-9]
/assets/room01/gaussians_v2.usdc
/assets/room01/room01_scene_v2.usda

# Downloaded runtimes and third-party reference source copies are local.
/tools/*
!/tools/modeling_blender_deb/
/tools/modeling_blender_deb/*
!/tools/modeling_blender_deb/blender.sh

# Generated training runs and episodes are local. Selected review images
# and evidence files are explicitly allowed below.
/outputs/**
/reports/**
!/outputs/**/
!/reports/**/

